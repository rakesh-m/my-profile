rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Résumé content: any signed-in (Google-authenticated) user may read.
    // Writes are not allowed from the client — content is managed by the
    // project owner via the Firebase console or an admin (privileged) SDK.
    match /resume/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
